# Configuration for Academic Literature Review System
DATABASE_URL=sqlite:///./literature_review.db
APP_ENV=development
LOG_LEVEL=INFO

# Academic Provider Polite Pool Contacts (Recommended for OpenAlex & Crossref rate limits)
POLITE_EMAIL=student.researcher@example.edu

# Optional API Keys (Leave blank to use public endpoints)
SEMANTIC_SCHOLAR_API_KEY=

# Search Defaults
DEFAULT_MAX_PAPERS=25
PROVIDER_TIMEOUT_SECONDS=15
MAX_RETRIES=2

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

